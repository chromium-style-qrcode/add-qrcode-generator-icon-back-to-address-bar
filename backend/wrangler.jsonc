{
  "name": "qrcode-pro-license",
  "main": "worker.ts",
  "compatibility_date": "2026-11-19",
  "kv_namespaces": [
    {
      "binding": "LICENSE_KV",
      "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
    }
  ],
  "routes": [
    {
      "pattern": "license.example.com",
      "custom_domain": true
    }
  ]
}
